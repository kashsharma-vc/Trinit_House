# Django Core Settings
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DEBUG=True

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Gemini AI Assistant
GEMINI_API_KEY=

# ─── VibeConnect SSO Configuration ──────────────────────────────────────────
# Set to True to enable Single Sign-On from VibeConnect
VIBECONNECT_SSO_ENABLED=False

# Client credentials issued by VibeConnect for Trinity Workshop
VIBECONNECT_CLIENT_ID=trinity-workshop-app
VIBECONNECT_CLIENT_SECRET=replace-with-secure-vibeconnect-client-secret

# Server-to-server authorization code verification URL on VibeConnect
# In production, this MUST use HTTPS. Example: https://vibeconnect.example.com/api/v1/sso/validate/
VIBECONNECT_VALIDATE_URL=https://vibeconnect.example.com/api/v1/sso/validate/

# Expected token issuer identifier (optional, validated if configured)
VIBECONNECT_EXPECTED_ISSUER=vibeconnect

# Server-to-server request timeout in seconds
VIBECONNECT_SSO_TIMEOUT=5.0

# Pre-provisioned demo username to map demo sessions to (must exist and be active)
VIBECONNECT_DEMO_USERNAME=demo_user
